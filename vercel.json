{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "runtime": "python",
      "maxDuration": 30,
      "excludeFiles": "{frontend/**,frontend/node_modules/**,frontend/dist/**,frontend/build/**,frontend/.venv/**,node_modules/**,dist/**,build/**,.venv/**,__pycache__/**,**/*.pyc,**/*.pyo,**/*.pyd}"
    }
  }
}

{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": [
        "node_modules/**",
        "dist/**",
        "build/**",
        ".venv/**",
        "__pycache__/**",
        "*.pyc",
        "*.pyo",
        "*.pyd"
      ]
    }
  }
}